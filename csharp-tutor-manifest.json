  "retiredSkills": [
    "csharp-docs",
    "csharp-review",
    "csharp-style"
  ],
  "install": {
    "defaultDestination": "%USERPROFILE%\\.codex\\skills",
    "defaultUnixDestination": "$HOME/.codex/skills",
    "remoteInstaller": "scripts/install-latest.ps1",
    "remoteShellInstaller": "scripts/install-latest.sh",
    "localInstaller": "scripts/install-csharp-tutor.ps1",
    "healthCheck": "scripts/test-csharp-tutor.ps1",
    "releaseHelper": "scripts/release.ps1",
    "backupRestore": "scripts/restore-backup.ps1",
    "catalogGenerator": "scripts/generate-skills-catalog.ps1",
    "maintenanceDashboard": "scripts/get-maintenance-dashboard.ps1"
  }
}
