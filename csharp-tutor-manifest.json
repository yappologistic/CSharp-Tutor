  "skills": [
    "csharp-api-design",
    "csharp-architecture",
    "csharp-analyzers",
    "csharp-aot",
    "csharp-aspnet",
    "csharp-async",
    "csharp-blazor",
    "csharp-build",
    "csharp-cheatsheets",
    "csharp-collections",
    "csharp-concurrency",
    "csharp-containers",
    "csharp-debug",
    "csharp-debug-lab",
    "csharp-design-patterns",
    "csharp-di",
    "csharp-efcore",
    "csharp-errors",
    "csharp-explain",
    "csharp-generics",
    "csharp-grpc",
    "csharp-help",
    "csharp-interview",
    "csharp-json",
    "csharp-linq",
    "csharp-logging",
    "csharp-maui",
    "csharp-migration",
    "csharp-modernize",
    "csharp-nullability",
    "csharp-nuget",
    "csharp-oop",
    "csharp-performance",
    "csharp-plan",
    "csharp-practice",
    "csharp-project",
    "csharp-quickfix",
    "csharp-regex",
    "csharp-refactor",
    "csharp-security",
    "csharp-signalr",
    "csharp-sourcegen",
    "csharp-tests",
    "csharp-tutor",
    "csharp-versioning"
